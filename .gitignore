# Python
__pycache__/
*.pyc
.pytest_cache/
.venv/
*.egg-info/
build/
dist/

# Generated media (regenerate via `syncsentry benchmark` / `gen-fixture`)
analyzer/fixtures/*.mkv
analyzer/fixtures/*.mp4
analyzer/fixtures/*.vtt
benchmark/results/_fixtures/

# Real (third-party) content used for M3b validation -- never committed,
# even under a permissive license. Re-fetch via
# analyzer/scripts/fetch_real_content.sh. Only SOURCES.md (provenance +
# license + fetch instructions) is tracked.
analyzer/fixtures/real_content/*
!analyzer/fixtures/real_content/SOURCES.md

# Vendored third-party code + pretrained weights (M3c SyncNet, see
# analyzer/scripts/fetch_syncnet.sh) -- never committed, same policy as above.
analyzer/third_party/*
!analyzer/third_party/SOURCES.md

# Go
services/orchestrator/bin/
.pytest_cache

# Analyzer editable install metadata
analyzer/*.egg-info/

# OS
.DS_Store

services/orchestrator/syncsentry-orchestrator
