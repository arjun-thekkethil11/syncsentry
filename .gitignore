# Python
__pycache__/
*.pyc
.pytest_cache/
.venv/
*.egg-info/
build/
dist/

# Generated media (regenerate via `syncsentry benchmark` / `gen-fixture`)
analyzer/fixtures/*.mkv
analyzer/fixtures/*.mp4
analyzer/fixtures/*.vtt
benchmark/results/_fixtures/

# Blind benchmark: generated clips and raw per-case results (regenerate via
# analyzer/scripts/blind_benchmark/{gen_clips,run_benchmark}.py).
analyzer/scripts/blind_benchmark/_out/

# Real (third-party) content used for validation, never committed even
# under a permissive license. Re-fetch via
# analyzer/scripts/fetch_real_content.sh. Only SOURCES.md is tracked.
analyzer/fixtures/real_content/*
!analyzer/fixtures/real_content/SOURCES.md

# Vendored third-party code and pretrained weights, never committed.
analyzer/third_party/*
!analyzer/third_party/SOURCES.md

# Analyzer editable install metadata
analyzer/*.egg-info/

# OS
.DS_Store

# Editor / agent tooling, not part of the project
.cursor/
.vscode/
